<!-- Appended to /var/ossec/etc/rules/local_rules.xml on SIEM01.
     Prerequisites on CA01: CA "Audit" tab (all boxes) +
     auditpol /set /subcategory:"{0CCE9221-69AE-11D9-BED3-505054503030}" /success:enable /failure:enable
     Test: net stop certsvc && net start certsvc  ->  rule 100200, agent CA01. -->
<group name="windows,adcs,">

  <rule id="100200" level="5">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4880$|^4881$</field>
    <description>AD CS: Certificate Services started or stopped</description>
  </rule>

  <rule id="100201" level="5">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4887$</field>
    <description>AD CS: certificate issued by the CA</description>
  </rule>

  <rule id="100202" level="10">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4882$|^4885$|^4890$|^4899$|^4900$</field>
    <description>AD CS: CA security, configuration or template changed</description>
    <mitre>
      <id>T1649</id>
    </mitre>
  </rule>

  <rule id="100203" level="10">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4876$|^4877$</field>
    <description>AD CS: CA database and keys backed up or restored</description>
  </rule>

</group>
